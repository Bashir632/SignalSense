<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Cellular Telemetry"
            android:textColor="@color/on_surface"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif"
            android:text="Active SIM, Cell Tower ID &amp; Radio Signal Metrics"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />

        <!-- Operator & SIM Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Network &amp; SIM Details"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:stretchColumns="1">

                    <TableRow android:layout_marginBottom="6dp">
                        <TextView
                            android:fontFamily="sans-serif"
                            android:text="Operator: "
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvCellOperator"
                            android:fontFamily="sans-serif-medium"
                            android:text="Scanning..."
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />
                    </TableRow>

                    <TableRow android:layout_marginBottom="6dp">
                        <TextView
                            android:fontFamily="sans-serif"
                            android:text="Network Type: "
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvCellNetworkType"
                            android:fontFamily="sans-serif-medium"
                            android:text="LTE / 5G / GSM"
                            android:textColor="@color/primary"
                            android:textSize="13sp" />
                    </TableRow>

                    <TableRow android:layout_marginBottom="6dp">
                        <TextView
                            android:fontFamily="sans-serif"
                            android:text="MCC / MNC: "
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvCellMccMnc"
                            android:fontFamily="monospace"
                            android:text="--- / ---"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:fontFamily="sans-serif"
                            android:text="Cell ID (CID): "
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvCellId"
                            android:fontFamily="monospace"
                            android:text="---"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />
                    </TableRow>

                </TableLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Signal Strength Metrics Grid -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Radio Signal Measurements"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="2">

                    <!-- RSSI -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_badge_idle"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="RSSI"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCellRssi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="-85 dBm"
                            android:textColor="@color/cellular_accent"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- RSRP -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_badge_idle"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="RSRP"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCellRsrp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="-98 dBm"
                            android:textColor="@color/cellular_accent"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- RSRQ -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_badge_idle"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="RSRQ"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCellRsrq"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="-11 dB"
                            android:textColor="@color/cellular_accent"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- SINR -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_idle"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="SINR"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCellSinr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="14.2 dB"
                            android:textColor="@color/cellular_accent"
                            android:textSize="18sp" />
                    </LinearLayout>

                </GridLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Permission Notice / Status -->
        <TextView
            android:id="@+id/tvCellPermissionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Requires READ_PHONE_STATE &amp; ACCESS_FINE_LOCATION permissions for physical cell measurements."
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
