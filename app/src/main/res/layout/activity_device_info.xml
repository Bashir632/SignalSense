<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:navigationIcon="@drawable/ic_chevron_right"
            app:title="@string/title_device_info" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Hardware &amp; System"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:stretchColumns="1">

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView
                                android:fontFamily="sans-serif"
                                android:text="Device Model: "
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tvDeviceModel"
                                android:fontFamily="sans-serif-medium"
                                android:text="Pixel 8 Pro"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView
                                android:fontFamily="sans-serif"
                                android:text="Manufacturer: "
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tvDeviceManufacturer"
                                android:fontFamily="sans-serif-medium"
                                android:text="Google"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView
                                android:fontFamily="sans-serif"
                                android:text="Android OS: "
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tvDeviceAndroidVersion"
                                android:fontFamily="sans-serif-medium"
                                android:text="Android 14 (API 34)"
                                android:textColor="@color/primary"
                                android:textSize="13sp" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView
                                android:fontFamily="sans-serif"
                                android:text="Build Fingerprint: "
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tvDeviceFingerprint"
                                android:fontFamily="monospace"
                                android:text="google/husky/husky..."
                                android:textColor="@color/on_surface"
                                android:textSize="11sp" />
                        </TableRow>

                    </TableLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Telemetry Sensors Detected"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvSensorListOverview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="4dp"
                        android:text="Detecting sensors..."
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
