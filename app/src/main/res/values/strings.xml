    <!-- Module descriptions -->
    <string name="desc_sensors_module">Hardware sensors: Accelerometer, Gyroscope, Magnetometer, Barometer, Light &amp; Proximity.</string>
    <string name="desc_cellular_module">Active SIM, MCC/MNC, Cell ID, network type, RSSI, RSRP, RSRQ, SINR measurements.</string>
    <string name="desc_wifi_module">Connected SSID, BSSID, RSSI dBm, frequency channels, and nearby access points.</string>
    <string name="desc_collection_module">Configure aggregation windows, session naming, recording, and storage parameters.</string>
    <string name="desc_history_module">Inspect saved local sessions, record counts, timelines, and stored metrics.</string>
    <string name="desc_visualization_module">Real-time and historical multi-axis charts, statistical mean, std dev, min/max.</string>
    <string name="desc_export_module">Export sensor, cellular, Wi-Fi, and combined datasets in standard CSV and JSON.</string>
    <string name="desc_device_info_module">Hardware architecture, Android OS version, battery status, and sensor specs.</string>
    <string name="desc_permissions_module">Audit and manage runtime permissions required for sensor &amp; signal telemetry.</string>
    <string name="desc_settings_module">Sampling intervals, display preferences, theme selection, and laptop backend sync.</string>
    <string name="desc_about_module">SignalSense architecture, hardware specifications, and system information.</string>

    <!-- About & Disclaimer -->
    <string name="about_body">SignalSense is a professional smartphone-based multi-signal monitoring and local data collection application designed for precision hardware sensor, cellular network, and Wi-Fi access point measurements.\n\nStrictly deterministic telemetry without artificial intelligence or machine learning frameworks.</string>
    <string name="about_developer">Engineered with Kotlin, Material Design 3, Room SQLite, SensorManager, TelephonyManager &amp; WifiManager.</string>
